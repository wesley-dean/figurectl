PROJECT_NAME           = "$(FIGURECTL_DOXYGEN_PROJECT_NAME)"
PROJECT_BRIEF          = "Reference documentation for figurectl Bash and AWK source"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX          = NO
GENERATE_MAN           = NO
GENERATE_RTF            = NO
GENERATE_XML            = NO
INPUT                  = src \
                         lib \
                         scripts \
                         doc/adr
RECURSIVE              = YES
FILE_PATTERNS          = *.bash \
                         *.sh \
                         *.awk \
                         *.md
EXCLUDE                = dist \
                         tests \
                         vendor \
                         doc/reference \
                         doc/adr/templates \
                         doc/adr/preflight-checklist.md \
                         doc/adr/README.intro.md \
                         doc/adr/README.outro.md
EXCLUDE_PATTERNS       = */dist/* \
                         */tests/* \
                         */vendor/* \
                         */doc/reference/* \
                         */doc/adr/templates/* \
                         */README.intro.md \
                         */README.outro.md
EXTENSION_MAPPING      = bash=C \
                         sh=C \
                         awk=C++
FILTER_PATTERNS        = *.bash=vendor/doxygen-bash.awk \
                         *.sh=vendor/doxygen-bash.awk \
                         *.awk=vendor/doxygen-awk.awk
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = doc/adr/README.md
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
